<Window x:Class="ElainaPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ElainaChat"
        Width="1180" Height="800"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#EEF1F5"
        Topmost="False"
        ShowInTaskbar="True"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        StateChanged="Window_StateChanged">

    <Grid x:Name="RootGrid" Margin="6">
        <Border x:Name="Shell" Background="#EEF1F5" CornerRadius="18" ClipToBounds="True">
          <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏 -->
            <Border Grid.Row="0" x:Name="TitleBar" Background="#F7F9FC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid Margin="14,0,10,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="◈ ElainaChat" FontWeight="700" FontSize="14" Foreground="#253040" VerticalAlignment="Center"/>
                        <TextBlock Text="魔女之旅 · 伊蕾娜" Margin="10,0,0,0" FontSize="12" Foreground="#7D8DA5" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="MinBtn" Content="—" Width="34" Height="28" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Min_Click"/>
                        <Button x:Name="MaxBtn" Content="□" Width="34" Height="28" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Max_Click"/>
                        <Button x:Name="CloseBtn" Content="✕" Width="34" Height="28" FontSize="12" Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#D64545" Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 主体：聊天界面 -->
            <wv2:WebView2 x:Name="WebView" Grid.Row="1"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
        </Border>
    </Grid>
</Window>
